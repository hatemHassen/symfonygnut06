<div class="container my-5">
    <h4>Mes paiements</h4>

    {% if data_items is defined and data_items['data'] is not empty %}
        <table class="table table-striped table-hover dataTable">
            <thead class="table-dark">
            <tr>
                <th>Numéro de commande</th>
                <th>Nom</th>
                <th>produit</th>
                <th>Date</th>
                <th>Montant</th>
            </tr>
            </thead>
            <tbody>
            {% for item in data_items['data'] %}
                {% include 'profil/payments.html.twig' %}
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun paiement à afficher.</p>
    {% endif %}
</div>
<tr>
    <td>{{ item.order.id }}</td>
    <td>{{ item.order.formName }}</td>
    <td>{% if item.name is defined %}{{ item.name }}{% endif %}</td>
    <td>{{ item.order.date|format_datetime(pattern="d MMMM y 'à' HH'h'mm':'s", locale='fr', timezone='Europe/Paris') }}</br>
        Mode de paiement : {{ item.paymentMeans }}</td>
    <td>{{ formattedPrice(item.amount) }}</td>
</tr>