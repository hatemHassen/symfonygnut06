{% extends 'profil/index.html.twig' %}
{% block section %}
    <div class="container my-5">
        <h4>Mes derniers paiements</h4>
         <table class="table table-striped table-hover dataTable">
                <thead class="table-dark">
                <tr>
                    <th>Numéro de commande</th>
                    <th>Nom</th>
                    <th>produit</th>
                    <th>Date</th>
                    <th>Montant</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
{% endblock %}
{% block javascripts%}
    {{ parent() }}
    <link href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/3.0.7/css/responsive.dataTables.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.js" type="text/javascript"></script>
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js" type="text/javascript"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.7/js/dataTables.responsive.js" type="text/javascript"></script>


    <script>
        // Initialise DataTables
        $(document).ready(function() {
                new DataTable('.dataTable', {
                    responsive: true,
                    processing: true,
                    serverSide: true,  // server handles pagination, search, sort
                    ajax: '{{ url("app_profil_payments_data") }}',
                    columns: [
                        { data: 'orderId' },
                        { data: 'name' },
                        { data: 'orderName' },
                        { data: 'date' },
                        { data: 'price' }
                    ],
                    pageLength: 10, // number of rows per page
                });
        });
    </script>
{% endblock %}